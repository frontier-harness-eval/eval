{
  "f15333e4523dc852": {
    "agents": [
      {
        "name": "opencode",
        "model_name": "zhipuai-eval/glm-5.3-flash",
        "kwargs": {
          "version": "1.18.19",
          "opencode_config": {
            "$schema": "https://opencode.ai/config.json",
            "model": "zhipuai-eval/glm-5.3-flash",
            "small_model": "zhipuai-eval/glm-5.3-flash",
            "enabled_providers": [
              "zhipuai-eval"
            ],
            "autoupdate": false,
            "share": "disabled",
            "provider": {
              "zhipuai-eval": {
                "npm": "@ai-sdk/openai-compatible",
                "name": "Zhipu Coding Plan (evaluation)",
                "options": {
                  "baseURL": "https://open.bigmodel.cn/api/coding/paas/v4",
                  "apiKey": "{env:ZHIPU_API_KEY}"
                },
                "models": {
                  "glm-5.3-flash": {
                    "name": "GLM-5.3-Flash",
                    "reasoning": true,
                    "tool_call": true,
                    "attachment": true,
                    "temperature": true,
                    "interleaved": {
                      "field": "reasoning_content"
                    },
                    "limit": {
                      "context": 1000000,
                      "output": 128000
                    },
                    "modalities": {
                      "input": [
                        "text",
                        "image"
                      ],
                      "output": [
                        "text"
                      ]
                    },
                    "options": {
                      "thinking": {
                        "type": "enabled",
                        "clear_thinking": false
                      },
                      "reasoningEffort": "max",
                      "tool_stream": true
                    }
                  }
                }
              }
            }
          }
        },
        "env": {
          "ZHIPU_API_KEY": "${ZHIPU_API_KEY}"
        }
      }
    ],
    "environment": {
      "type": "docker",
      "delete": true
    },
    "runner": "pier"
  },
