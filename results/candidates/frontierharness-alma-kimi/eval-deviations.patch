@@ -173,6 +173,23 @@ def _kimi_code(text: str) -> Detail:
     return _detail(usages)
 
 
+def _alma(text: str) -> Detail:
+    # fw-proxy.mjs records one line per upstream chat/completions response
+    # ({"t":…,"status":…,"prompt":…,"completion":…,"cached":…}); the driver
+    # writes this trial's slice into the agent dir. OpenAI semantics: prompt
+    # includes cached. A call that never returned a usage block (non-200,
+    # transport error) carries a null prompt and is not a turn.
+    usages = []
+    for event in _jsonl(text):
+        total = event.get("prompt")
+        if total is None:
+            continue
+        cached = int(event.get("cached") or 0)
+        if int(total) or event.get("completion"):
+            usages.append((int(total), cached))
+    return _detail(usages)
+
+
 def _hermes(text: str) -> Detail:
     # Per-call records from the eval-usage plugin (post_api_request hook):
     # input_tokens is fresh-only, cache_read_tokens the cached portion.
