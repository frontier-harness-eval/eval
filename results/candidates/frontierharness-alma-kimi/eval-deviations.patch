     --cpus) CPUS=$2; shift 2 ;;
@@ -188,6 +194,22 @@ rexec "test \"\$$SECRET_NAME\" = runta-secret-stub" \
 # Bootstrap needs package and source registries. Apply restricted egress only after
 # installation and sample warmup, before freezing the checkpoint.
 
+CLONE_SRC=$REPO
+if [ -n "$REPO_BUNDLE" ]; then
+  [ -f "$REPO_BUNDLE" ] || { echo "repo bundle not found: $REPO_BUNDLE" >&2; exit 1; }
+  step "2b/9 uploading harness bundle $(basename "$REPO_BUNDLE")"
+  # `runta run` returns while the runtime is still creating; cp streams over an exec
+  # session and fails with "channel closed" until the runtime accepts exec.
+  tries=0
+  until runta exec "$RUNTIME" -- sh -c 'mkdir -p /work' >/dev/null 2>&1; do
+    tries=$((tries + 1))
+    [ "$tries" -lt 60 ] || { echo "runtime $RUNTIME did not become ready for exec" >&2; exit 1; }
+    sleep 5
+  done
+  retry_transport runta cp "$REPO_BUNDLE" "$RUNTIME:/work/harness.bundle"
+  CLONE_SRC=/work/harness.bundle
+fi
