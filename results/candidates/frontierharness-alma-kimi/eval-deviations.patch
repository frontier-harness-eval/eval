   \"harness_repo\": \"$REPO\",
+  \"harness_source\": \"$( [ -n "$REPO_BUNDLE" ] && echo "git bundle uploaded from the operator machine" || echo "git clone over the network" )\",
   \"harness_commit\": \"\$(git rev-parse HEAD)\",
   \"harness_describe\": \"\$(git describe --tags --always 2>/dev/null || echo unknown)\",
   \"model\": \"$MODEL\",
@@ -321,6 +345,13 @@ copy_verified "$RUNTIME:/work/manifest.json" "./manifest-${CHECKPOINT}.json" "$m
 jq -e . "./manifest-${CHECKPOINT}.json" >/dev/null \
   || { echo "manifest did not copy out of $RUNTIME" >&2; exit 1; }
 
+# Keep the memory snapshot small before checkpointing: the install leaves most of the
+# guest's RAM as page cache. (The hard limit on checkpoint creation is the disk delta,
+# not the cache: on 2026-09-05 a clean runtime checkpointed in ~30 s, +5 GiB in ~90 s,
+# and +10 GiB / +20 GiB never left `creating`, cold cache or not. Hence no --prepull-tasks
+# for the golden image; trials pull their task image at run time instead.)
+rexec "sync; echo 3 > /proc/sys/vm/drop_caches; free -m | head -2"
+
 runta checkpoint create "$RUNTIME" "$CHECKPOINT"
 if ! wait_for_checkpoint "$CHECKPOINT" "$CHECKPOINT_TIMEOUT"; then
   echo "Build runtime retained: $RUNTIME. Inspect the checkpoint before retrying; no ready checkpoint is being claimed." >&2
