 step "3/9 installing base tooling"
 rexec 'set -eu
   export DEBIAN_FRONTEND=noninteractive
@@ -202,7 +224,7 @@ step "4/9 cloning $REPO at $COMMIT"
 rexec "set -eu
   export PATH=\"\$HOME/.local/bin:\$PATH\"
   rm -rf /work/harness
-  git clone --quiet '$REPO' /work/harness
